{
  "expo": {
    "name": "Textmob",
    "slug": "mobile",
    "version": "1.4",
    "scheme": "textmob",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.bossprogrammer20.mobile",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "cd3ed21d-7bd6-4b73-b893-1fbc3a9b67de"
      }
    },
    "owner": "bossprogrammer20",
    "plugins": [
      "./plugins/withInstallPackages",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      "expo-audio",
      "expo-document-picker",
      "expo-image-picker",
      "expo-media-library",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563eb"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ],
      "expo-status-bar",
      "expo-video",
      "./plugins/withResourceConfigs"
    ]
  }
}
